# Where new orders are sent. Configure at least one, otherwise checkout is disabled in production.

# Option 1 — Telegram (recommended): every order arrives as a message on your phone.
#   1. In Telegram, talk to @BotFather → /newbot → copy the token below.
#   2. Send any message to your new bot, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...} below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Option 2 — Webhook: the full order is POSTed as JSON (e.g. a Google Apps Script
# that appends rows to a Google Sheet, or a Make / Zapier webhook).
ORDER_WEBHOOK_URL=

# Public URL of the site (used for the sitemap). Optional on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
