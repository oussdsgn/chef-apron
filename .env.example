# ---------- Required ----------

# Server access to Firebase (Firestore database, login checks, photo uploads).
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the WHOLE downloaded JSON file as the value (one line is fine).
FIREBASE_SERVICE_ACCOUNT=

# Public web-app config for the Google sign-in button.
# Firebase console → Project settings → General → Your apps → Web app → "firebaseConfig".
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google emails that always have dashboard access (comma-separated).
# Owners can add more people from Dashboard → Settings.
ADMIN_EMAILS=

# ---------- Optional ----------

# Store product photos in Firebase Storage (requires the Blaze plan), e.g. apron-12345.firebasestorage.app
# Without it, photos are stored in Firestore (each photo must be under ~1 MB; the dashboard compresses them).
FIREBASE_STORAGE_BUCKET=

# Get a Telegram message for every new order:
#   1. In Telegram, talk to @BotFather → /newbot → copy the token.
#   2. Send any message to your bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates
#      and copy "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Also POST each order as JSON to this URL (Google Sheets script, Make, Zapier…).
ORDER_WEBHOOK_URL=

# Public URL used in the sitemap (defaults to the Vercel production domain).
NEXT_PUBLIC_SITE_URL=

# Alternative to FIREBASE_SERVICE_ACCOUNT: the three values from the same JSON file.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
