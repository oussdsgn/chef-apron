# ---------- Required ----------

# Postgres database. On Vercel: Storage → Create → Neon (Postgres) → connect to this project.
# That sets DATABASE_URL automatically. Tables and starter products are created on first visit.
DATABASE_URL=

# Google sign-in for the dashboard (/admin). See README → "Google sign-in".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret that signs login sessions. Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=

# Your site's address, e.g. https://apron.dz (on your computer: http://localhost:3000)
NEXTAUTH_URL=

# Google emails that always have dashboard access (comma-separated).
# Owners can add more people from Dashboard → Settings.
ADMIN_EMAILS=

# ---------- Optional ----------

# Faster photo hosting. On Vercel: Storage → Create → Blob → connect to this project.
# Without it, uploaded photos are stored in the database.
BLOB_READ_WRITE_TOKEN=

# Get a Telegram message for every new order:
#   1. In Telegram, talk to @BotFather → /newbot → copy the token.
#   2. Send any message to your bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates
#      and copy "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Also POST each order as JSON to this URL (Google Sheets script, Make, Zapier…).
ORDER_WEBHOOK_URL=

# Public URL used in the sitemap (defaults to the Vercel production domain).
NEXT_PUBLIC_SITE_URL=
