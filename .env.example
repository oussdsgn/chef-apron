# Stripe secret key (from https://dashboard.stripe.com/apikeys).
# Without it the store works fully, but checkout shows a "payments not configured" notice.
STRIPE_SECRET_KEY=sk_test_xxx

# Public URL of the site, used for Stripe success/cancel redirects.
# On Vercel this falls back to VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
